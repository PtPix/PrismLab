{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "my-project",
      "displayName": "Prism only",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/my-project",
      "cacheVariables": {
        "PRISM_BUILD_ALL_PROJECTS": "OFF"
      }
    },
    {
      "name": "all-projects",
      "displayName": "Prism and all Donut examples",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/all-projects",
      "cacheVariables": {
        "PRISM_BUILD_ALL_PROJECTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "my-project",
      "displayName": "Prism only (Release)",
      "configurePreset": "my-project",
      "configuration": "Release",
      "targets": [
        "PrismForward",
        "PrismContract",
        "PrismStarter"
      ]
    },
    {
      "name": "my-project-debug",
      "displayName": "Prism only (Debug)",
      "configurePreset": "my-project",
      "configuration": "Debug",
      "targets": [
        "PrismForward",
        "PrismContract",
        "PrismStarter"
      ]
    },
    {
      "name": "all-projects",
      "configurePreset": "all-projects",
      "configuration": "Release",
      "targets": [
        "PrismAllProjects"
      ]
    }
  ]
}

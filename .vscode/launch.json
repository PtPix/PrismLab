// F5 调试配置（需要 ms-vscode.cpptools）。preLaunchTask 会先构建再启动，
// 构建逻辑仍在根目录的 prism.ps1 里，这里不重复写 cmake 命令。
//
// 程序是 WIN32 子系统：stdout 不可见，运行日志见 build/my-project/bin/Debug/prism.log
// （无头参数运行时一定写文件；交互运行时日志显示在应用内控制台）。
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Prism: Deferred",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/my-project/bin/Debug/PrismDeferred.exe",
            "args": [],
            "cwd": "${workspaceFolder}/build/my-project/bin/Debug",
            "console": "internalConsole",
            "preLaunchTask": "Prism: build (Debug)",
            "stopAtEntry": false
        },
        {
            "name": "Prism: Deferred (capture frame 4)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/my-project/bin/Debug/PrismDeferred.exe",
            "args": [ "--capture", "deferred_capture.png", "--capture-frame", "4" ],
            "cwd": "${workspaceFolder}/build/my-project/bin/Debug",
            "console": "internalConsole",
            "preLaunchTask": "Prism: build (Debug)",
            "stopAtEntry": false
        }
    ]
}

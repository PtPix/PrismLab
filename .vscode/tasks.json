// 构建 / 运行任务。所有任务都通过仓库根的 prism.ps1 执行，
// 因此 cmake 的位置、preset 配置、目标名与运行参数只有一处定义。
//
// 用法：Ctrl+Shift+P -> Tasks: Run Task，或 Ctrl+Shift+B 直接构建（默认任务）。
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prism: configure",
            "detail": "cmake --preset my-project（生成 build/my-project）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-ConfigureOnly"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Prism: build (Debug)",
            "detail": "构建 ForwardExperiment / ContractExperiment / Starter（Debug）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "All", "-NoRun"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: build (Release)",
            "detail": "构建 ForwardExperiment / ContractExperiment / Starter（Release）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "All", "-Config", "Release", "-NoRun"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: run ForwardExperiment",
            "detail": "构建并启动共享前向管线实验（交互窗口）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismForward"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: run ContractExperiment (self check)",
            "detail": "契约自检 30 帧后退出，失败返回非零退出码",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismContract",
                "-AppArgs", "--smoke-test=30",
                "-TailLog"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: run Starter",
            "detail": "构建并启动最小三角形成立示例",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismStarter"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: bench ForwardExperiment (120 frames)",
            "detail": "预热 30 帧后测量 120 帧，写出 forward_bench.csv",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismForward",
                "-AppArgs", "--bench=120", "--metrics", "forward_bench.csv",
                "-TailLog"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        }
    ]
}

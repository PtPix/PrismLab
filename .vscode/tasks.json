// 构建 / 运行任务。所有任务都通过仓库根的 prism.ps1 执行，
// 因此 cmake 的位置、preset 配置、目标名与运行参数只有一处定义。
//
// 用法：Ctrl+Shift+P -> Tasks: Run Task，或 Ctrl+Shift+B 直接构建（默认任务）。
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prism: configure",
            "detail": "cmake --preset my-project（生成 build/my-project）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-ConfigureOnly"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Prism: build (Debug)",
            "detail": "构建 PrismDeferred（Debug）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismDeferred", "-NoRun"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: build (Release)",
            "detail": "构建 PrismDeferred（Release）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismDeferred", "-Config", "Release", "-NoRun"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: run Deferred",
            "detail": "构建并启动延迟渲染实验",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismDeferred"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Prism: bench Deferred (120 frames)",
            "detail": "预热 30 帧后测量 120 帧，写出 deferred_bench.csv",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/prism.ps1",
                "-Target", "PrismDeferred",
                "-AppArgs", "--bench=120", "--metrics", "deferred_bench.csv",
                "-TailLog"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        }
    ]
}
